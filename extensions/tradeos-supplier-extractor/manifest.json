{
  "manifest_version": 3,
  "name": "TradeOS Supplier Extractor",
  "version": "0.1.0",
  "description": "Extract supplier data from B2B platforms and send to TradeOS for AI analysis",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://*.alibaba.com/*",
    "https://*.made-in-china.com/*",
    "https://*.globalsources.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.alibaba.com/*",
        "https://*.made-in-china.com/*",
        "https://*.globalsources.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
